import asyncio
from poke_env import AccountConfiguration, ServerConfiguration, RandomPlayer

# Your specific GitHub Codespace domain
CODESPACE_DOMAIN = "automatic-trout-7rvwvpw4wqx2xp7g.github.dev"

# Setup cloud configuration
codespace_config = ServerConfiguration(
    f"https://{CODESPACE_DOMAIN}/action.php?",
    f"wss://{CODESPACE_DOMAIN}/showdown/websocket"
)

async def main():
    # Initialize the bot account
    bot = RandomPlayer(
        account_configuration=AccountConfiguration("bobthebot3", "Xj3$2F*8oI$lde"),
        server_configuration=codespace_config,
        battle_format="gen9randombattle"
    )

    print("Bot is connecting to Codespace and listening for challenges...")
    # Replace 'YourUsername' with your main Showdown account name
    await bot.accept_challenges("YourUsername", n_challenges=1)

if __name__ == "__main__":
    asyncio.run(main())
